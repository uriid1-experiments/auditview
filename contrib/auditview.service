[Unit]
Description=auditview — auditd web UI and alerting
Documentation=file:///usr/local/share/doc/auditview/README.md
After=auditd.service network.target
Wants=auditd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/auditview
Restart=on-failure
RestartSec=5

# Работает от root: чтение /var/log/audit, правка /etc/audit/rules.d,
# запись /var/lib/auditview. NoNewPrivileges нельзя — desktop-канал
# алертов использует sudo -u для notify-send в сессию пользователя.
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
