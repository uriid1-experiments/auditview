[Unit]
Description=auditview — auditd web UI and alerting
Documentation=file:///usr/local/share/doc/auditview/README.md
After=auditd.service network.target
Wants=auditd.service

[Service]
Type=simple
ExecStart=/usr/local/bin/auditview
Restart=on-failure
RestartSec=5

# Runs as root: reads /var/log/audit, edits /etc/audit/rules.d, writes
# /var/lib/auditview. NoNewPrivileges is not an option: the desktop alert
# channel uses sudo -u to run notify-send inside the user session.
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
